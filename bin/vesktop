#!/usr/bin/env bash
if flatpak info dev.vencord.Vesktop >/dev/null 2>&1; then
    exec flatpak run dev.vencord.Vesktop "$@"
elif command -v vesktop >/dev/null 2>&1; then
    exec vesktop "$@"
else
    echo "Vesktop is not installed. Install via Flatpak: flatpak install -y flathub dev.vencord.Vesktop" >&2
    exit 1
fi
