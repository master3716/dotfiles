#!/usr/bin/env bash
if command -v zen-browser >/dev/null 2>&1; then
    exec zen-browser "$@"
elif command -v zen >/dev/null 2>&1; then
    exec zen "$@"
elif flatpak info app.zen_browser.zen >/dev/null 2>&1; then
    exec flatpak run app.zen_browser.zen "$@"
else
    echo "Zen Browser is not installed. Install via Flatpak: flatpak install -y flathub app.zen_browser.zen" >&2
    exit 1
fi
