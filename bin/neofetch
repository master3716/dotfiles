#!/usr/bin/env bash
# ============================================================
# Dragon Ball Neofetch / dbfetch (powered by Fastfetch)
# ============================================================

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_ROOT="${SCRIPT_DIR}/.."
REPO_DATA_DIR="${REPO_ROOT}/data/dragonball"

DBZ_DIR="${HOME}/.local/share/dragonball-neofetch"
ANSI_DIR="${DBZ_DIR}/ascii"
MANIFEST="${DBZ_DIR}/manifest.json"
if [[ ! -d "$ANSI_DIR" && -d "${REPO_DATA_DIR}/ascii" ]]; then
    ANSI_DIR="${REPO_DATA_DIR}/ascii"
fi
if [[ ! -f "$MANIFEST" && -f "${REPO_DATA_DIR}/manifest.json" ]]; then
    MANIFEST="${REPO_DATA_DIR}/manifest.json"
fi

# Self-heal: extract vendored fastfetch if missing from ~/.local/bin and PATH
ARCH="$(uname -m)"
VENDOR_FF="${REPO_ROOT}/vendor/bin/${ARCH}/fastfetch.tar.xz"
if [[ ! -x "${HOME}/.local/bin/fastfetch" ]] && ! command -v fastfetch &>/dev/null && [[ -f "$VENDOR_FF" ]]; then
    mkdir -p "${HOME}/.local/bin" 2>/dev/null || true
    tar -xJf "$VENDOR_FF" -C "${HOME}/.local/bin" 2>/dev/null || true
    chmod +x "${HOME}/.local/bin/fastfetch" 2>/dev/null || true
fi

if [[ -x "${HOME}/.local/bin/fastfetch" ]]; then
    FASTFETCH_BIN="${HOME}/.local/bin/fastfetch"
else
    FASTFETCH_BIN="$(command -v fastfetch 2>/dev/null || true)"
fi
CLASSIC_NEOFETCH="${HOME}/.local/libexec/neofetch-classic"

# Fallback check
if [[ ! -d "$ANSI_DIR" || -z "$FASTFETCH_BIN" ]]; then
    if [[ -x "$CLASSIC_NEOFETCH" ]]; then
        exec "$CLASSIC_NEOFETCH" "$@"
    elif [[ -n "$FASTFETCH_BIN" ]]; then
        exec "$FASTFETCH_BIN" "$@"
    fi
    echo "dbfetch: fastfetch is not installed or Dragon Ball ASCII data is missing." >&2
    exit 1
fi

case "${1:-}" in
    --classic)
        shift
        exec "$CLASSIC_NEOFETCH" "$@"
        ;;
    --list)
        echo -e "\033[1;38;2;122;162;247mAvailable Dragon Ball Characters:\033[0m"
        if [[ -f "$MANIFEST" ]] && command -v python3 &>/dev/null; then
            python3 -c "
import json
with open('$MANIFEST') as f:
    items = json.load(f)
seen = set()
for i in sorted(items, key=lambda x: (x.get('universe', ''), x['name'])):
    name = i['name']
    u = i.get('universe', 'Universe 7')
    if name not in seen:
        seen.add(name)
        print(f'  • {name:<28} \033[38;2;125;207;255m[{u}]\033[0m')
"
        else
            for f in "$ANSI_DIR"/*.ansi; do
                base=$(basename "$f" .ansi)
                echo "  • ${base//_/ }"
            done | sort -u
        fi
        exit 0
        ;;
    --version|-v)
        exec "$FASTFETCH_BIN" --version
        ;;
    --help|-h)
        cat << 'EOF'
dbfetch / neofetch - System information tool with Dragon Ball characters

Usage:
  dbfetch                      Show system info with a random Dragon Ball character
  dbfetch <character>          Show system info with a specific character or form
                               Examples:
                                 dbfetch goku
                                 dbfetch "ssj goku"
                                 dbfetch "ssj blue vegeta"
                                 dbfetch "ultra instinct"
                                 dbfetch frieza
  dbfetch --list               List all available Dragon Ball characters
  dbfetch --classic            Run classic original neofetch
  dbfetch [fastfetch-opts]     Forward options to fastfetch
EOF
        exit 0
        ;;
esac

CHOSEN=""

# Search matching character if specified
if [[ -n "${1:-}" && "${1:-}" != -* ]]; then
    QUERY="$1"
    shift
    if [[ -f "$MANIFEST" ]] && command -v python3 &>/dev/null; then
        CHOSEN=$(python3 -c "
import json, os, sys, random
q = sys.argv[1].lower()
ansi_dir = sys.argv[2]
with open(sys.argv[3]) as f:
    items = json.load(f)
words = q.split()
matches = [
    i['ansi'] if os.path.exists(i['ansi']) else os.path.join(ansi_dir, os.path.basename(i['ansi']))
    for i in items
    if all(w in i['name'].lower() or w in i['slug'].lower() for w in words)
]
matches = [m for m in matches if os.path.exists(m)]
if matches:
    print(random.choice(matches))
" "$QUERY" "$ANSI_DIR" "$MANIFEST")
    fi

    # Fallback to direct filename matching if not found via manifest
    if [[ -z "$CHOSEN" || ! -f "$CHOSEN" ]]; then
        safe_q=$(echo "$QUERY" | tr '[:upper:]' '[:lower:]' | tr ' ' '_')
        matches=("$ANSI_DIR"/*"$safe_q"*.ansi)
        if [[ -f "${matches[0]}" ]]; then
            CHOSEN="${matches[RANDOM % ${#matches[@]}]}"
        fi
    fi
fi

# Pick random character if none specified or matched
if [[ -z "$CHOSEN" || ! -f "$CHOSEN" ]]; then
    all_chars=("$ANSI_DIR"/*.ansi)
    if (( ${#all_chars[@]} > 0 )); then
        CHOSEN="${all_chars[RANDOM % ${#all_chars[@]}]}"
    fi
fi

# Execute fastfetch with neofetch layout and chosen Dragon Ball logo
if [[ -n "$CHOSEN" && -f "$CHOSEN" ]]; then
    "$FASTFETCH_BIN" -c neofetch --logo-type file --logo "$CHOSEN" --logo-padding-right 3 "$@" 2>/dev/null && exit 0
    exec "$FASTFETCH_BIN" --logo-type file --logo "$CHOSEN" --logo-padding-right 3 "$@"
else
    "$FASTFETCH_BIN" -c neofetch "$@" 2>/dev/null && exit 0
    exec "$FASTFETCH_BIN" "$@"
fi
