# ==============================================================================
# Ghostty Configuration — Black & Red Minimalist Dark
# ==============================================================================

# Black Background & Refined Red Accent
background = #0b0b0b
foreground = #d0d0d0
cursor-color = #ba3b40
cursor-text = #0b0b0b
selection-background = #380d10
selection-foreground = #ffffff

# Black & Red ANSI Palette (Muted, Non-Piercing)
# Normal
palette = 0=#0b0b0b
palette = 1=#ba3b40
palette = 2=#8f1419
palette = 3=#a8393e
palette = 4=#b8474d
palette = 5=#c74248
palette = 6=#b8595e
palette = 7=#d0d0d0
# Bright
palette = 8=#383838
palette = 9=#c74248
palette = 10=#ba3b40
palette = 11=#c2555b
palette = 12=#b8474d
palette = 13=#a8393e
palette = 14=#b8595e
palette = 15=#ffffff

# Typography
font-family = JetBrains Mono
font-size = 13
font-feature = +liga
font-feature = +calt

# Window & Padding
window-theme = dark
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-padding-color = background
background-opacity = 1
background-blur = false
unfocused-split-opacity = 1

# GTK / Titlebar Integration
gtk-titlebar = true
gtk-tabs-location = top
gtk-wide-tabs = false

# Cursor Styling
cursor-style = bar
cursor-style-blink = true

# Behavior & Usability
mouse-hide-while-typing = true
confirm-close-surface = false
copy-on-select = clipboard
shell-integration = detect
