# ==============================================================================
# Ghostty Configuration — Black & Red Minimalist Dark
# ==============================================================================

# Black Background & Vivid Red Accent
background = #0b0b0b
foreground = #e6e6e6
cursor-color = #d71921
cursor-text = #0b0b0b
selection-background = #4a0d11
selection-foreground = #ffffff

# Black & Red ANSI Palette
# Normal
palette = 0=#0b0b0b
palette = 1=#d71921
palette = 2=#8f1419
palette = 3=#b01319
palette = 4=#c41e24
palette = 5=#e5323c
palette = 6=#ff4d4d
palette = 7=#d4d4d4
# Bright
palette = 8=#333333
palette = 9=#ff3b30
palette = 10=#d71921
palette = 11=#ff4d4d
palette = 12=#e5323c
palette = 13=#ff6b6b
palette = 14=#ff8585
palette = 15=#ffffff

# Typography
font-family = JetBrains Mono
font-size = 13
font-feature = +liga
font-feature = +calt

# Window & Padding
window-theme = dark
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-padding-color = background
background-opacity = 1
background-blur = false
unfocused-split-opacity = 1

# GTK / Titlebar Integration
gtk-titlebar = true
gtk-tabs-location = top
gtk-wide-tabs = false

# Cursor Styling
cursor-style = bar
cursor-style-blink = true

# Behavior & Usability
mouse-hide-while-typing = true
confirm-close-surface = false
copy-on-select = clipboard
shell-integration = detect
