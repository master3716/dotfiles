# ==============================================================================
# Ghostty Configuration — Nothing OS Matte Black with Red Accents
# ==============================================================================

# Black Background & Nothing Red Accent
background = #0b0b0b
foreground = #c0caf5
cursor-color = #d71921
cursor-text = #0b0b0b
selection-background = #361518
selection-foreground = #ffffff

# Balanced ANSI Palette (Green for existing commands, Red for errors)
# Normal
palette = 0=#0b0b0b
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#c0caf5
# Bright
palette = 8=#414868
palette = 9=#ff4d4d
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#82aaff
palette = 13=#c792ea
palette = 14=#7dcfff
palette = 15=#ffffff

# Typography
font-family = JetBrains Mono
font-size = 13
font-feature = +liga
font-feature = +calt

# Window & Padding
window-theme = dark
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-padding-color = background
background-opacity = 1
background-blur = false
unfocused-split-opacity = 1

# GTK / Titlebar Integration
gtk-titlebar = true
gtk-tabs-location = top
gtk-wide-tabs = false

# Cursor Styling
cursor-style = bar
cursor-style-blink = true

# Behavior & Usability
mouse-hide-while-typing = true
confirm-close-surface = false
copy-on-select = clipboard
shell-integration = detect
