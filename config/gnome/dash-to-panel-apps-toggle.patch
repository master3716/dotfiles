+  _adaptAppsPageToggle() {
+    this._injectionManager.overrideMethod(
+      Object.getPrototypeOf(Main.overview),
+      'toggle',
+      () => () => {
+        if (Main.overview.isDummy) return
+
+        if (Main.overview.visible) {
+          Main.overview.hide()
+        } else {
+          Main.overview.showApps()
+        }
+      },
+    )
+
+    Utils.removeKeybinding('toggle-application-view')
+    Utils.addKeybinding(
+      'toggle-application-view',
+      new Gio.Settings({ schema_id: 'org.gnome.shell.keybindings' }),
+      () => {
+        if (Main.overview.visible) {
+          Main.overview.hide()
+        } else {
+          Main.overview.showApps()
+        }
+      },
+    )
+  }
+
+  _restoreAppsPageToggle() {
+    Utils.removeKeybinding('toggle-application-view')
+    let overviewControls = Main.overview._overview?._controls
+    if (overviewControls) {
+      Utils.addKeybinding(
+        'toggle-application-view',
+        new Gio.Settings({ schema_id: 'org.gnome.shell.keybindings' }),
+        overviewControls._toggleAppsPage.bind(overviewControls),
+      )
+    }
+  }
 
